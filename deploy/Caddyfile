primaries.fit {
    # 'current' is a symlink that deploy.sh flips atomically to the latest
    # release directory — see scripts/deploy.sh. Caddy needs no restart or
    # reload when it changes; it just reads through the symlink per request.
    root * /opt/primaries-fit/current
    encode zstd gzip

    header {
        # HSTS — Caddy already redirects HTTP→HTTPS, this tells browsers to
        # never try plaintext for a year.
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # Don't advertise the server software.
        -Server
    }

    # The app is a client-side-routed SPA (react-router — /e/:eventId/… deep
    # links, the event chooser at /). Every request other than a real static
    # asset must fall through to index.html so those routes resolve on a cold
    # load or refresh; the router then renders the right screen.
    try_files {path} /index.html
    file_server
}

# To add another app on this host in the future:
#
# another.example.com {
#     reverse_proxy localhost:8081
# }
#
# Then: sudo systemctl reload caddy
