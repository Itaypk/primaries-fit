{
  "$comment": "The elicitation layer. Questions target PARAMETERS by id. Order = presentation order. Reword/reorder freely without touching candidates. Mirrors the prototype's 11 questions.",
  "id": "hademokratim-v1",
  "version": 1,
  "questions": [
    {
      "id": "q_economy",
      "widget": "slider",
      "topic": { "he": "כלכלה", "en": "Economy" },
      "title": { "he": "איזו גישה כלכלית קרובה לליבך?", "en": "Which economic approach is closer to you?" },
      "targets": [{ "parameter": "economy" }]
    },
    {
      "id": "q_imp_security",
      "widget": "importance",
      "topic": { "he": "ביטחון", "en": "Security" },
      "title": { "he": "עד כמה תחום הביטחון מכריע עבורך בבחירה?", "en": "How decisive is security in your choice?" },
      "importanceFor": ["security"]
    },
    {
      "id": "q_security",
      "widget": "slider",
      "topic": { "he": "ביטחון", "en": "Security" },
      "title": { "he": "בסוגיות ביטחון, לאן נוטה עמדתך?", "en": "On security matters, where do you lean?" },
      "targets": [{ "parameter": "security" }]
    },
    {
      "id": "q_court_political",
      "widget": "boolean",
      "topic": { "he": "מערכת המשפט", "en": "The judiciary" },
      "title": { "he": "מערכת המשפט", "en": "The judiciary" },
      "statement": { "he": "בית המשפט העליון הוא גורם פוליטי.", "en": "The Supreme Court is a political actor." },
      "targets": [{ "parameter": "court_political" }]
    },
    {
      "id": "q_judiciary",
      "widget": "slider",
      "topic": { "he": "רפורמה משפטית", "en": "Judicial reform" },
      "title": { "he": "באיזון בין רשויות השלטון, את מי לחזק?", "en": "In balancing branches of power, whom to strengthen?" },
      "targets": [{ "parameter": "judiciary_balance" }]
    },
    {
      "id": "q_religion_sep",
      "widget": "boolean",
      "topic": { "he": "דת ומדינה", "en": "Religion & state" },
      "title": { "he": "דת ומדינה", "en": "Religion & state" },
      "statement": { "he": "יש להפריד בין דת למדינה.", "en": "Religion and state should be separated." },
      "targets": [{ "parameter": "religion_state_sep" }]
    },
    {
      "id": "q_champion",
      "widget": "multiselect",
      "topic": { "he": "נושאי דגל", "en": "Flagship issues" },
      "title": { "he": "אילו נושאים חשוב לך שהמועמד/ת יובילו?", "en": "Which issues should the candidate champion?" },
      "parameter": "flagship"
    },
    {
      "id": "q_imp_honesty",
      "widget": "importance",
      "topic": { "he": "יושרה ושקיפות", "en": "Integrity & transparency" },
      "title": { "he": "כמה משקל יש ליושרה ושקיפות בבחירתך?", "en": "How much weight do integrity and transparency carry?" },
      "importanceFor": ["honesty"]
    },
    {
      "id": "q_style",
      "widget": "slider",
      "topic": { "he": "סגנון מנהיגות", "en": "Leadership style" },
      "title": { "he": "איזה סגנון מנהיגות מדבר אליך?", "en": "Which leadership style speaks to you?" },
      "targets": [{ "parameter": "leadership_style" }]
    },
    {
      "id": "q_ideology",
      "widget": "slider",
      "topic": { "he": "אידאולוגיה", "en": "Ideology" },
      "title": { "he": "עד כמה חשובה לך טהרנות אידאולוגית?", "en": "How ideologically pure should the candidate be?" },
      "targets": [{ "parameter": "ideology" }]
    },
    {
      "id": "q_imp_experience",
      "widget": "importance",
      "topic": { "he": "ניסיון", "en": "Experience" },
      "title": { "he": "כמה משקל לניסיון (פוליטי וכללי)?", "en": "How much weight for experience (political & other)?" },
      "importanceFor": ["experience"]
    }
  ]
}
